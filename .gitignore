# pyenv
#   For a library or app, you might want to share your .python-version.
#   For an app, you may want to restrict the version.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in git.
#   However, in case of collaboration, if the platform is not identical, the lock
#   file will not be usable.
# Pipfile.lock

# poetry
#   Similar to Pipenv, poetry.lock contains exact versions of dependencies.
#   Many choose to publish lock files in their git repositories.
# poetry.lock

# pdm
#   PDM stores project-wide configurations in .pdm.toml
.pdm.toml
pdm.lock
.pdm-plugins/

